# Copy to .env and adjust for local runs (Docker supplies these via docker-compose.yml).
# Port the Express + Socket.IO server listens on.
PORT=5001
# MongoDB connection string. When unset, the server falls back to an in-memory
# MongoDB (non-Docker dev convenience). In Docker this points at the mongo service.
MONGO_URI=mongodb://127.0.0.1:27017/pawhub
# Secret used to sign JWT auth tokens. Change this in any real deployment.
JWT_SECRET=change_me_in_production
